# Environment Configuration Template for Jason's Landscaping Business System
# Copy this file to .env.local for local development
# Configure these variables in Netlify dashboard for production deployment

# Turso Database Configuration
# Get these values from your Turso dashboard: https://turso.tech/
REACT_APP_TURSO_DATABASE_URL=libsql://your-database-name-your-organization.turso.io
REACT_APP_TURSO_AUTH_TOKEN=your-auth-token-here

# Optional: Turso Sync URL for offline-first functionality
# This enables local replica database that syncs with cloud
REACT_APP_TURSO_SYNC_URL=libsql://your-database-name-your-organization.turso.io

# Application Environment
REACT_APP_ENVIRONMENT=development

# Optional: Enable debug logging for database operations
REACT_APP_DEBUG_DATABASE=false

# Build Configuration (automatically set by Netlify)
# GENERATE_SOURCEMAP=false
# CI=true